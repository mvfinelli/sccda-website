---
/* schedule.astro — Season Schedule
   Embeds Dart Connect schedule via iframe.
   Season label + iframe URL come from src/lib/season.js. */

import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import IframeEmbed from '../components/IframeEmbed.astro';
import { season } from '../lib/season.js';
---

<BaseLayout title="Schedule" description={`SCCDA ${season.label} Season Schedule — weekly matchups and venues.`}>

  <Hero
    label={season.label}
    heading="Season<br/>Schedule"
    bgText="SCHEDULE"
  />

  <IframeEmbed
    src={season.scheduleUrl}
    title="SCCDA Season Schedule"
    height={1000}
  />

</BaseLayout>
